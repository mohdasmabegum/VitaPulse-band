{
  "hosting": {
    "public": "frontend",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/auth/**",        "function": "api" },
      { "source": "/recommend**",    "function": "api" },
      { "source": "/history**",      "function": "api" },
      { "source": "/symptom-check**","function": "api" },
      { "source": "/upload-report**","function": "api" }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
